<Window
    x:Class="PasMan.Views.SaveConfirmationWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Confirm Save"
    Width="420"
    Height="170"
    CanResize="False"
    WindowStartupLocation="CenterOwner">

    <StackPanel Margin="16" Spacing="12">
        <TextBlock
            x:Name="MessageTextBlock"
            TextWrapping="Wrap"
            Text="Save changes to this password entry?" />
        <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="8">
            <Button Click="OnCancelClick">Cancel</Button>
            <Button IsDefault="True" Click="OnSaveClick">Save</Button>
        </StackPanel>
    </StackPanel>
</Window>
