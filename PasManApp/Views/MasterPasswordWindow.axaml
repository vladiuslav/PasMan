<Window
    x:Class="PasMan.Views.MasterPasswordWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Unlock Vault"
    Width="360"
    Height="170"
    CanResize="False"
    WindowStartupLocation="CenterOwner">

    <StackPanel Margin="16" Spacing="10">
        <TextBlock Text="Enter master password to unlock your vault." />
        <TextBox x:Name="PasswordTextBox" PasswordChar="*" />
        <TextBlock x:Name="ErrorTextBlock" IsVisible="False" Foreground="IndianRed" />
        <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="8">
            <Button Click="OnCancelClick">Cancel</Button>
            <Button IsDefault="True" Click="OnOpenClick">Open</Button>
        </StackPanel>
    </StackPanel>
</Window>
